PHOTOSYNC_STORAGE=/mnt/hsk/photosync
PHOTOSYNC_DATABASE=/var/lib/photosync/photosync.db
# Put the same unique random value into /mnt/hsk/photosync/.photosync-storage-id
PHOTOSYNC_STORAGE_ID=replace-with-a-unique-random-value
PHOTOSYNC_REQUIRE_NFS=1
PHOTOSYNC_MAX_BYTES=10737418240
PHOTOSYNC_MAX_UPLOADS=2
