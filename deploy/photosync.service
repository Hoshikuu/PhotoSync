[Unit]
Description=PhotoSync local backup API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photosync
Group=photosync
WorkingDirectory=/opt/photosync
EnvironmentFile=/etc/photosync.env
ExecStart=/opt/photosync/.venv/bin/uvicorn photosync.app:app --host 192.168.1.202 --port 8080 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/photosync /mnt/photosync
UMask=0077

[Install]
WantedBy=multi-user.target
